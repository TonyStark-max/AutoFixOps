# AutoFixOps Environment Configuration

# GitHub Configuration
GITHUB_TOKEN=your_github_token_here

# AWS Configuration (Leave blank if using IAM roles / metadata service)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Amazon Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-sonnet-5
# Or whatever Claude ID is preferred

# PostgreSQL Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/autofixops
DATABASE_USERNAME=autofixops_user
DATABASE_PASSWORD=your_db_password_here

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_AUTHORIZED_CHAT_IDS=123456789,987654321
